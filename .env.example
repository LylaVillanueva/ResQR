# Copy to .env.local and fill in Project B's public client values.
# Leave EXPO_PUBLIC_BACKEND_MODE unset to keep using legacy Express.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
EXPO_PUBLIC_BACKEND_MODE=supabase

# Keep this only when running the legacy Express backend.
EXPO_PUBLIC_API_BASE_URL=https://<legacy-api-host>/api
